{
  "version": 2,
  "builds": [
    {
      "src": "backend/AthensSecret.Api/AthensSecret.Api.csproj",
      "use": "@vercel/dotnet"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/AthensSecret.Api"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "ASPNETCORE_ENVIRONMENT": "Production"
  }
}
